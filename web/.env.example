# Puertos del entorno de desarrollo del frontend.
# Copiar a web/.env solo si hay que cambiarlos; sin fichero valen estos.
#
# Se sacan a variables para poder convivir con otros proyectos en la misma
# maquina: el 5173 de Vite lo usa cualquier otro front.

WEB_PORT=5180

# A donde proxea Vite las llamadas a /api y /uploads. Tiene que coincidir con
# el PORT de api/.env.
API_URL=http://localhost:4100
