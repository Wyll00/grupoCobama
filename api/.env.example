# API - copiar a api/.env
# 4100 y no 4000: el 4000 lo usa cualquier otro Express de la maquina.
PORT=4100
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cobama
DB_PASSWORD=cobama
DB_NAME=cobama

# Origenes permitidos por CORS, separados por coma.
# Tiene que coincidir con WEB_PORT de web/.env
CORS_ORIGIN=http://localhost:5180

# Base publica de la web, usada para generar los QR de cada local
WEB_BASE_URL=http://localhost:5180

# --- Autenticacion ---------------------------------------------------------
# OBLIGATORIO en produccion. Si se deja vacio en desarrollo se genera uno
# temporal en cada arranque, asi que las sesiones abiertas se invalidan al
# reiniciar la API. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Duracion del access token (formato de vercel/ms: 15m, 1h, 7d)
JWT_ACCESS_TTL=15m
# Duracion de la cookie de refresco, en dias
JWT_REFRESH_TTL_DIAS=7

# --- Imagenes --------------------------------------------------------------
UPLOADS_DIR=uploads
UPLOAD_MAX_MB=8
